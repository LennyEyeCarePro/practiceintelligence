# Real client data that must never be committed or deployed. Anything under api/
# is served as a static file by Vercel, so a committed dossier would be publicly
# fetchable at /api/<filename>. This one is a client onboarding document
# (Lakeshore Optical) including staff names. It does not belong in api/ at all —
# move it out of the repo.
api/*.txt
api/Dossier*

# Secrets — never commit. hubspot-setup/.env and serp-mvp/.env hold live API
# tokens and were nearly committed by a `git add -A`.
.env
.env.*
!.env.example
**/.env
**/.env.*
**/!.env.example

node_modules/
local/node_modules/
local/public/
.vercel
.DS_Store

# Standalone side projects that live in this directory but are not part of the
# deployed app. Kept out of the repo deliberately.
hubspot-setup/
serp-mvp/
sales-handoff/
kit-host/
post-suspension/
Documents/
main
screen5_backup_COMPLETE.html
